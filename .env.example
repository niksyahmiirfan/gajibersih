# --- Site ---
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_GA_ID=            # GA4 measurement ID, e.g. G-XXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=   # e.g. ca-pub-1234567890123456

# --- Content pipeline (choose one provider; all have free tiers — verify current limits) ---
LLM_PROVIDER=gemini           # gemini | groq | github | cloudflare | mock
LLM_MODEL=                    # optional override, e.g. gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=                 # GitHub Models (in Actions use the built-in token with models: read)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional stronger model used only by the verifier's claim check
LLM_VERIFY_PROVIDER=
LLM_VERIFY_MODEL=

# --- Metrics collector ---
GOOGLE_SERVICE_ACCOUNT_JSON=  # full JSON of a service account added to Search Console + GA4
GSC_SITE_URL=sc-domain:example.com
GA4_PROPERTY_ID=              # numeric property ID
ADSENSE_ACCOUNT=              # accounts/pub-1234567890123456
ADSENSE_CLIENT_ID=            # OAuth client (AdSense API does not accept service accounts)
ADSENSE_CLIENT_SECRET=
ADSENSE_REFRESH_TOKEN=
